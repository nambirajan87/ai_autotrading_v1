# ==========================================
# Application & Risk Defaults
# ==========================================
TRADING_MODE=PAPER
LOG_LEVEL=INFO

MAX_DAILY_LOSS=2000
MAX_RISK_PER_TRADE=0.01
MAX_POSITIONS=3

DATABASE_URL=
BROKER_API_KEY=
BROKER_API_SECRET=
