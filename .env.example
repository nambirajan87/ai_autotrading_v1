KOTAK_UCC=YOUR_CLIENT_ID
KOTAK_MPIN=XXXXXX
KOTAK_TOTP_SECRET=YOUR_TOTP_SECRET_OR_LEAVE_BLANK
KOTAK_SESSION_TOKEN=
